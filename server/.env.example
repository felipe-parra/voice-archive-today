NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://archive:local-development-only@localhost:55432/archive
WEB_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4173
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=audio
S3_ACCESS_KEY_ID=archive-local
S3_SECRET_ACCESS_KEY=local-development-only
S3_FORCE_PATH_STYLE=true
MAIL_MODE=development
DEV_MAIL_DIRECTORY=/tmp/voice-archive-mail
OPENAI_API_KEY=
