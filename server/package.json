{
  "name": "voice-archive-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server/src/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@hono/node-server": "^1.19.0",
    "@vercel/blob": "^1.1.1",
    "hono": "^4.9.0",
    "pg": "^8.16.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
