# Copy to .env and fill in. All optional for the fixture preview
# (VITE_USE_FIXTURES=true), required for live mode.

# Supabase (legacy — backend is being migrated off Supabase, see
# docs/render-migration.md). Leave unset to use the in-code fallback,
# which points at the decommissioned original project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fixture / demo mode — renders every screen with seed data, no backend.
# VITE_USE_FIXTURES=true
